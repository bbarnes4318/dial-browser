{
  "name": "Daily Summary Notifier",
  "description": "Sends a daily SMS summary to users listing their upcoming appointments and pending voice-based reminders scheduled for the day.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_summary_notifier",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_summaries": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendDailySummary"
          },
          "then": "end",
          "x-base44": {
            "title": "Send daily summaries",
            "description": "Daily SMS digest of today's reminders"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 9 * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}