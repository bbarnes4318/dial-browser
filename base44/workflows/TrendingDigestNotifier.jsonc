{
  "name": "Trending Digest Notifier",
  "description": "Sends a daily SMS digest to members with the top 3 trending voice services personalized to their listening history.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "trending_digest_notifier",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_digests": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendTrendingDigest"
          },
          "then": "end",
          "x-base44": {
            "title": "Send trending digests",
            "description": "Daily personalized SMS with top 3 services"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 8 * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}