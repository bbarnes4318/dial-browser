{
  "name": "Meetup Rating Followup",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 9 * * *",
      "one_time_date": null,
      "timezone": "America/Los_Angeles",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Every day at 9am, asks members whose mutual match is 3+ days old to rate how their meetup went \u2014 with a link back to their private dating dashboard. Feeds the community-quality ratings shown in the admin dashboard.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "meetup_rating_followup",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_rating_requests": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendMeetupRatingRequests"
          },
          "then": "end",
          "x-base44": {
            "title": "Send meetup rating requests",
            "description": "SMS members 3 days after a match"
          }
        }
      }
    ]
  }
}