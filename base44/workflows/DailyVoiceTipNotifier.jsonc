{
  "description": "Generates a fresh AI-powered voice-usage tip each morning and saves it as a dashboard notification",
  "name": "Daily Voice Tip Notifier",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_voice_tip_notifier",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_tip": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendDailyVoiceTip",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Generate & send daily voice tip",
            "description": "AI tip saved to dashboard notifications"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 8 * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}