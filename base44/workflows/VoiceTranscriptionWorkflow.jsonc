  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "voice_call_auto_transcription",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "transcribe_calls": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "autoTranscribeCalls",
