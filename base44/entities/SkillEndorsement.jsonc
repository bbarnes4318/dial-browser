{
  "name": "SkillEndorsement",
  "type": "object",
  "properties": {
    "candidate_phone": {
      "type": "string",
      "description": "Phone number of the candidate being endorsed (links to their profile)"
    },
    "candidate_name": {
      "type": "string",
      "description": "Name of the candidate (denormalized for display)"
    },
    "skill": {
      "type": "string",
      "description": "The specific skill being endorsed (e.g. JavaScript, Leadership)"
    },
    "rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "default": 5,
      "description": "Quick rating from 1 to 5 stars"
    },
    "comment": {
      "type": "string",
      "maxLength": 500,
      "description": "Optional short comment from the endorser"
    },
    "endorser_name": {
      "type": "string",
      "description": "Name of the past employer or colleague leaving the endorsement"
    },
    "endorser_company": {
      "type": "string",
      "description": "Company the endorser represents"
    },
    "endorser_role": {
      "type": "string",
      "description": "Role or title of the endorser (e.g. Former Manager, CTO)"
    }
  },
  "required": [
    "candidate_phone",
    "candidate_name",
    "skill",
    "rating",
    "endorser_name"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}