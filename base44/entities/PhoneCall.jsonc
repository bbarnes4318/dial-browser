{
  "name": "PhoneCall",
  "type": "object",
  "properties": {
    "owner_user_id": {
      "type": "string",
      "description": "User id of the member who owns this call log row"
    },
    "direction": {
      "type": "string",
      "enum": [
        "outbound",
        "inbound"
      ],
      "description": "Whether the call was placed by the member or received by them"
    },
    "from_number": {
      "type": "string",
      "description": "The calling party number (the member's Dial number for outbound, the remote caller for inbound)"
    },
    "to_number": {
      "type": "string",
      "description": "The called party number (the destination for outbound, the member's Dial number for inbound)"
    },
    "remote_number": {
      "type": "string",
      "description": "The other party's number, denormalized for easy list rendering"
    },
    "remote_label": {
      "type": "string",
      "description": "Optional contact name or display label for the other party"
    },
    "status": {
      "type": "string",
      "enum": [
        "connecting",
        "ringing",
        "in_progress",
        "completed",
        "failed",
        "no_answer",
        "voicemail",
        "busy"
      ],
      "default": "connecting",
      "description": "Lifecycle status of the call"
    },
    "duration_seconds": {
      "type": "number",
      "default": 0,
      "description": "Duration of the connected call in seconds"
    },
    "minutes_billed": {
      "type": "number",
      "default": 0,
      "description": "Whole minutes decremented from the member's cap for this call (ceil of duration_seconds / 60)"
    },
    "call_sid": {
      "type": "string",
      "description": "Twilio CallSid for this call"
    },
    "started_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the call started"
    },
    "ended_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the call ended"
    },
    "recorded": {
      "type": "boolean",
      "default": false,
      "description": "Whether this call was recorded (member enabled the dialer Record toggle)"
    },
    "recording_url": {
      "type": "string",
      "description": "Twilio recording audio URL, stored when the recording-status callback fires. Playable in call history."
    }
  },
  "required": [
    "owner_user_id",
    "direction",
    "remote_number"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}