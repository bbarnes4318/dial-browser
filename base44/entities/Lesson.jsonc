{
  "name": "Lesson",
  "type": "object",
  "properties": {
    "course_id": {
      "type": "string",
      "description": "Course this lesson belongs to"
    },
    "title": {
      "type": "string",
      "description": "Lesson title"
    },
    "lesson_text": {
      "type": "string",
      "maxLength": 8000,
      "description": "Full narration script read aloud by TTS during the voice lesson"
    },
    "summary": {
      "type": "string",
      "description": "Short one-line summary shown on the course outline"
    },
    "audio_url": {
      "type": "string",
      "description": "Cached pre-generated TTS narration URL (GenerateSpeech). Empty until generated."
    },
    "order_index": {
      "type": "number",
      "default": 0,
      "description": "Order of this lesson within the course (0-based)"
    },
    "duration_minutes": {
      "type": "number",
      "default": 0,
      "description": "Estimated narration length in minutes"
    }
  },
  "required": [
    "course_id",
    "title",
    "lesson_text"
  ],
  "rls": {
    "read": null,
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}