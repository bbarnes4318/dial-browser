{
  "name": "RealEstateInquiry",
  "type": "object",
  "properties": {
    "property_id": {
      "type": "string",
      "description": "RealEstateListing this inquiry is about"
    },
    "property_title": {
      "type": "string",
      "description": "Denormalized property title for display"
    },
    "buyer_name": {
      "type": "string",
      "description": "Name of the interested buyer"
    },
    "buyer_phone": {
      "type": "string",
      "description": "Buyer contact number"
    },
    "buyer_email": {
      "type": "string",
      "description": "Optional buyer email"
    },
    "message": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional buyer message to the agent"
    },
    "intent": {
      "type": "string",
      "enum": [
        "purchase",
        "tour",
        "info"
      ],
      "default": "purchase",
      "description": "What the buyer wants \u2014 purchase, schedule a tour, or more info"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "contacted",
        "closed"
      ],
      "default": "new",
      "description": "Agent/admin follow-up status"
    }
  },
  "required": [
    "property_id",
    "buyer_name",
    "buyer_phone"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}