{
  "name": "PhoneMessage",
  "type": "object",
  "properties": {
    "owner_user_id": {
      "type": "string",
      "description": "User id of the member who owns this message thread row"
    },
    "direction": {
      "type": "string",
      "enum": [
        "outbound",
        "inbound"
      ],
      "description": "Whether the SMS was sent by the member or received"
    },
    "from_number": {
      "type": "string",
      "description": "Sender number (the member's Dial number for outbound, the remote for inbound)"
    },
    "remote_number": {
      "type": "string",
      "description": "The other party's number, used to group a conversation thread"
    },
    "remote_label": {
      "type": "string",
      "description": "Optional contact name for the other party"
    },
    "body": {
      "type": "string",
      "maxLength": 1600,
      "description": "Message text"
    },
    "message_sid": {
      "type": "string",
      "description": "Twilio MessageSid for this SMS"
    },
    "status": {
      "type": "string",
      "enum": [
        "sent",
        "delivered",
        "received",
        "failed",
        "queued"
      ],
      "default": "queued",
      "description": "Delivery status of the SMS"
    },
    "read": {
      "type": "boolean",
      "default": false,
      "description": "Whether the member has opened this message"
    },
    "thread_id": {
      "type": "string",
      "description": "Stable conversation key (sorted pair of member + remote numbers) for grouping messages"
    }
  },
  "required": [
    "owner_user_id",
    "direction",
    "remote_number",
    "body"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}