{
  "name": "Course",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Course title"
    },
    "subtitle": {
      "type": "string",
      "description": "Short one-line tagline under the title"
    },
    "description": {
      "type": "string",
      "maxLength": 3000,
      "description": "Full course description shown on the course detail page"
    },
    "category": {
      "type": "string",
      "description": "Primary subject category (e.g. AI, Engineering, Nursing)"
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "beginner",
        "intermediate",
        "advanced"
      ],
      "default": "beginner",
      "description": "Entry level of the course"
    },
    "duration_hours": {
      "type": "number",
      "default": 0,
      "description": "Estimated total study hours to complete the course"
    },
    "recommended_weeks": {
      "type": "number",
      "default": 4,
      "description": "Recommended number of weeks to pace through the course"
    },
    "price": {
      "type": "number",
      "default": 0,
      "description": "One-time enrollment fee in USD that unlocks lessons + certificate. Must be >= 0.50 per Wix minimum. 0 = free."
    },
    "cover_art_url": {
      "type": "string",
      "description": "URL of the course cover image"
    },
    "cover_gradient": {
      "type": "string",
      "description": "CSS gradient string used for the generated cover when no image is set"
    },
    "instructor_name": {
      "type": "string",
      "description": "Denormalized display name of the assigned instructor"
    },
    "instructor_user_id": {
      "type": "string",
      "description": "User id of the assigned instructor who can edit this course"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published"
      ],
      "default": "draft",
      "description": "published courses are visible and dialable; drafts are admin/instructor only"
    },
    "certificate_eligible": {
      "type": "boolean",
      "default": true,
      "description": "Whether passing the final exam issues a completion certificate"
    },
    "dial_code": {
      "type": "string",
      "description": "Short dial code (e.g. *AI01) learners press to start this course by phone"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Free-form labels for filtering and search"
    },
    "enrollment_count": {
      "type": "number",
      "default": 0,
      "description": "Denormalized count of paid enrollments for quick display"
    },
    "is_seeded": {
      "type": "boolean",
      "default": false,
      "description": "Whether this course was created from the built-in curriculum template"
    }
  },
  "required": [
    "title",
    "category"
  ],
  "rls": {
    "read": null,
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.instructor_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}