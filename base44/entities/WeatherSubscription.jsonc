{
  "name": "WeatherSubscription",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string",
      "description": "Name of the subscriber receiving daily weather"
    },
    "phone": {
      "type": "string",
      "description": "Phone number to receive the daily weather SMS forecast"
    },
    "location": {
      "type": "string",
      "description": "City or location for the daily weather forecast"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Whether the subscription is currently active and receiving daily forecasts"
    }
  },
  "required": [
    "full_name",
    "phone",
    "location"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}