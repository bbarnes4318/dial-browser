{
  "name": "DialVoicePrompt",
  "type": "object",
  "properties": {
    "dial_code": {
      "type": "string",
      "description": "Which dial code this prompt is for (1-9, *, 0, #)"
    },
    "prompt_name": {
      "type": "string",
      "description": "Display name for this voice prompt"
    },
    "audio_url": {
      "type": "string",
      "description": "URL of the uploaded, recorded, or generated audio file"
    },
    "prompt_type": {
      "type": "string",
      "enum": [
        "greeting",
        "instructions",
        "farewell",
        "custom"
      ],
      "default": "custom",
      "description": "Type of voice prompt"
    },
    "voice_type": {
      "type": "string",
      "enum": [
        "human",
        "robotic"
      ],
      "default": "human",
      "description": "Whether this prompt uses a human-sounding or robotic-sounding voice"
    },
    "tts_text": {
      "type": "string",
      "description": "The text used to generate the audio (if generated via TTS), empty for uploaded/recorded clips"
    },
    "tts_voice": {
      "type": "string",
      "description": "Which TTS voice was used (river, honey, sunny, storm, spark), empty for uploaded/recorded clips"
    },
    "source_method": {
      "type": "string",
      "enum": [
        "upload",
        "record",
        "generate"
      ],
      "default": "upload",
      "description": "How the audio was created: uploaded file, live recording, or AI-generated"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this prompt is active and playing for callers"
    }
  },
  "required": [
    "dial_code",
    "prompt_name",
    "audio_url"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}