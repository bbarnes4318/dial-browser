{
  "name": "Referral",
  "type": "object",
  "properties": {
    "referrer_user_id": {
      "type": "string",
      "description": "User ID of the member who shared the referral link"
    },
    "referrer_name": {
      "type": "string",
      "description": "Display name of the referrer"
    },
    "referral_code": {
      "type": "string",
      "description": "Unique referral code derived from the user ID"
    },
    "referred_email": {
      "type": "string",
      "description": "Email of the person who was referred"
    },
    "referred_name": {
      "type": "string",
      "description": "Name of the person who was referred"
    },
    "service_shared": {
      "type": "string",
      "description": "Name of the voice service or page that was shared"
    },
    "share_url": {
      "type": "string",
      "description": "The full referral URL that was shared"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "completed",
        "rewarded"
      ],
      "default": "pending",
      "description": "Whether the referral signed up, and if credits were awarded"
    },
    "credits_earned": {
      "type": "number",
      "default": 0,
      "description": "Call credits awarded to the referrer when the referral completes"
    }
  },
  "required": [
    "referrer_user_id",
    "referral_code"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.referrer_user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.referrer_user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.referrer_user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}