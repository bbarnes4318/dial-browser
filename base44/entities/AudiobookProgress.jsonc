{
  "name": "AudiobookProgress",
  "type": "object",
  "properties": {
    "audiobook_id": {
      "type": "string",
      "description": "ID of the Audiobook this progress tracks"
    },
    "audiobook_title": {
      "type": "string",
      "description": "Title of the audiobook (denormalized for display)"
    },
    "position_seconds": {
      "type": "number",
      "default": 0,
      "description": "Where the listener left off, in seconds"
    },
    "duration_seconds": {
      "type": "number",
      "default": 0,
      "description": "Total duration of the current chapter's audio in seconds"
    },
    "chapter_index": {
      "type": "number",
      "default": 0,
      "description": "Chapter the listener was on when progress was last saved, so resume jumps to the exact chapter"
    },
    "completed": {
      "type": "boolean",
      "default": false,
      "description": "Whether the listener has finished this audiobook"
    },
    "last_listened_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of the last listening session"
    }
  },
  "required": [
    "audiobook_id"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}