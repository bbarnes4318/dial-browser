{
  "name": "RadioSchedule",
  "type": "object",
  "properties": {
    "show_name": {
      "type": "string",
      "description": "Name of the scheduled show or segment"
    },
    "artist_name": {
      "type": "string",
      "description": "Artist being featured or spotlighted"
    },
    "track_title": {
      "type": "string",
      "description": "Specific track being premiered or featured"
    },
    "genre": {
      "type": "string",
      "description": "Primary genre of the scheduled content"
    },
    "air_time": {
      "type": "string",
      "format": "date-time",
      "description": "When the show airs (ISO-8601)"
    },
    "duration_minutes": {
      "type": "number",
      "default": 30,
      "description": "Duration of the show in minutes"
    },
    "spotlight_type": {
      "type": "string",
      "enum": [
        "featured_track",
        "artist_spotlight",
        "premier",
        "live_session"
      ],
      "default": "featured_track",
      "description": "Type of radio content scheduled"
    },
    "description": {
      "type": "string",
      "maxLength": 500,
      "description": "Description of the scheduled show"
    },
    "status": {
      "type": "string",
      "enum": [
        "scheduled",
        "live",
        "aired",
        "cancelled"
      ],
      "default": "scheduled",
      "description": "Current status of the scheduled show"
    }
  },
  "required": [
    "show_name",
    "air_time"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}