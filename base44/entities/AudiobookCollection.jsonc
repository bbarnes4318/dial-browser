{
  "name": "AudiobookCollection",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Collection or playlist name (e.g. 'Road Trip', 'Bedtime')"
    },
    "description": {
      "type": "string",
      "maxLength": 500,
      "description": "Optional short description of the collection"
    },
    "audiobook_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Ordered audiobook ids saved in this collection"
    },
    "is_favorites": {
      "type": "boolean",
      "default": false,
      "description": "Whether this is the auto-managed Favorites collection (one per user)"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}