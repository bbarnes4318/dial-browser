{
  "name": "CallbackRequest",
  "type": "object",
  "properties": {
    "listing_id": {
      "type": "string",
      "description": "ID of the DialServiceListing this callback is for"
    },
    "provider_name": {
      "type": "string",
      "description": "Name of the provider (denormalized for display)"
    },
    "caller_name": {
      "type": "string",
      "description": "Name of the person requesting a callback"
    },
    "caller_phone": {
      "type": "string",
      "description": "Phone number for the provider to call back"
    },
    "service_needed": {
      "type": "string",
      "description": "Description of the service needed"
    },
    "preferred_time": {
      "type": "string",
      "enum": [
        "asap",
        "morning",
        "afternoon",
        "evening",
        "flexible"
      ],
      "default": "flexible",
      "description": "Preferred time for the callback"
    },
    "notes": {
      "type": "string",
      "maxLength": 500,
      "description": "Additional notes for the provider"
    },
    "status": {
      "type": "string",
      "enum": [
        "requested",
        "confirmed",
        "completed",
        "cancelled"
      ],
      "default": "requested",
      "description": "Current status of the callback request"
    }
  },
  "required": [
    "listing_id",
    "provider_name",
    "caller_name",
    "caller_phone",
    "service_needed"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}