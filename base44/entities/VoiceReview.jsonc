{
  "name": "VoiceReview",
  "type": "object",
  "properties": {
    "track_id": {
      "type": "string",
      "description": "ID of the ArtistTrack being reviewed"
    },
    "track_title": {
      "type": "string",
      "description": "Title of the reviewed track (denormalized)"
    },
    "artist_name": {
      "type": "string",
      "description": "Artist name of the reviewed track (denormalized)"
    },
    "reviewer_name": {
      "type": "string",
      "description": "Name of the listener leaving the voice review"
    },
    "audio_url": {
      "type": "string",
      "description": "URL of the recorded voice clip"
    },
    "transcript": {
      "type": "string",
      "maxLength": 2000,
      "description": "Transcribed text of the voice review"
    },
    "rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "default": 5,
      "description": "Star rating from 1 to 5"
    }
  },
  "required": [
    "track_id",
    "track_title",
    "artist_name",
    "reviewer_name"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}