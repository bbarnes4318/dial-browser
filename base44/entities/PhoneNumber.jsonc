{
  "name": "PhoneNumber",
  "type": "object",
  "properties": {
    "owner_user_id": {
      "type": "string",
      "description": "User id of the member who owns this personal Dial number (empty for the shared line)"
    },
    "owner_name": {
      "type": "string",
      "description": "Denormalized owner display name"
    },
    "number": {
      "type": "string",
      "description": "Provisioned Twilio DID in E.164 format (e.g. +15125551234)"
    },
    "friendly_name": {
      "type": "string",
      "description": "Human-readable label for the number"
    },
    "twilio_sid": {
      "type": "string",
      "description": "Twilio IncomingPhoneNumber resource sid (PN...) for this DID"
    },
    "assignment_type": {
      "type": "string",
      "enum": [
        "personal",
        "shared"
      ],
      "default": "personal",
      "description": "personal = a paid member's own Dial number; shared = the platform shared line used by free members for outbound"
    },
    "status": {
      "type": "string",
      "enum": [
        "provisioning",
        "active",
        "provisioning_failed",
        "released"
      ],
      "default": "provisioning",
      "description": "Lifecycle of the number provisioning"
    },
    "region": {
      "type": "string",
      "description": "ISO country / area code region the number was provisioned in"
    },
    "provisioned_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the number was successfully provisioned"
    },
    "failure_reason": {
      "type": "string",
      "description": "Reason the provisioning failed, if status is provisioning_failed"
    }
  },
  "required": [
    "owner_user_id",
    "number",
    "assignment_type"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.assignment_type": "shared"
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}