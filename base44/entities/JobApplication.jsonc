{
  "name": "JobApplication",
  "type": "object",
  "properties": {
    "applicant_name": {
      "type": "string",
      "description": "Name of the job seeker submitting the application"
    },
    "applicant_phone": {
      "type": "string",
      "description": "Phone number where the applicant can be reached"
    },
    "applicant_email": {
      "type": "string",
      "description": "Optional email address for the applicant"
    },
    "job_listing_id": {
      "type": "string",
      "description": "Reference to the JobListing this application is for"
    },
    "job_title": {
      "type": "string",
      "description": "Title of the job (denormalized for display)"
    },
    "company": {
      "type": "string",
      "description": "Company posting the job (denormalized)"
    },
    "field": {
      "type": "string",
      "description": "Job field category (denormalized)"
    },
    "notes": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional cover message or notes from the applicant"
    },
    "status": {
      "type": "string",
      "enum": [
        "submitted",
        "viewed",
        "shortlisted",
        "interview_requested",
        "rejected",
        "hired",
        "archived"
      ],
      "default": "submitted",
      "description": "Current stage of the application"
    },
    "resume_url": {
      "type": "string",
      "description": "URL of the applicant's uploaded resume file"
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "List of skills the applicant has (e.g. JavaScript, SEO, Forklift)"
    },
    "experience_years": {
      "type": "number",
      "description": "Years of professional experience the applicant has"
    },
    "work_history": {
      "type": "string",
      "maxLength": 2000,
      "description": "Summary of the applicant's previous work experience"
    },
    "desired_location": {
      "type": "string",
      "description": "City or region where the applicant prefers to work"
    }
  },
  "required": [
    "applicant_name",
    "applicant_phone",
    "job_listing_id",
    "job_title",
    "company"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}