{
  "name": "Question",
  "type": "object",
  "properties": {
    "assessment_id": {
      "type": "string",
      "description": "Assessment this question belongs to"
    },
    "course_id": {
      "type": "string",
      "description": "Denormalized course id for convenient filtering"
    },
    "type": {
      "type": "string",
      "enum": [
        "multiple_choice",
        "true_false",
        "short_answer",
        "essay"
      ],
      "description": "multiple_choice + true_false are DTMF-graded; short_answer + essay are spoken and LLM-graded"
    },
    "prompt": {
      "type": "string",
      "description": "The question text read aloud to the learner"
    },
    "options": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Ordered answer options for multiple_choice questions"
    },
    "correct_option_index": {
      "type": "number",
      "description": "Index of the correct option for multiple_choice / true_false"
    },
    "correct_answer_text": {
      "type": "string",
      "description": "Reference correct answer for short_answer (used as LLM grading reference)"
    },
    "rubric": {
      "type": "string",
      "description": "Grading rubric for short_answer and essay questions, passed to the LLM grader"
    },
    "marks": {
      "type": "number",
      "default": 1,
      "description": "Mark value of this question"
    },
    "order_index": {
      "type": "number",
      "default": 0,
      "description": "Order of this question within the assessment"
    }
  },
  "required": [
    "assessment_id",
    "type",
    "prompt"
  ],
  "rls": {
    "read": null,
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}